# Copy to .env and adjust. Never commit the real .env file.
POSTGRES_USER=flowops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=flowops
POSTGRES_PORT=5432

# Test database (must end with _test; the test suite refuses to run otherwise).
TEST_DATABASE_URL=postgresql+psycopg://flowops:change-me-locally@localhost:5432/flowops_test

# Set to true when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Used by the API. Inside Docker Compose the host is "db"; on your machine it is "localhost".
DATABASE_URL=postgresql+psycopg://flowops:change-me-locally@localhost:5432/flowops

# Frontend dev server proxies /api to this target (Compose overrides it to http://api:8000)
VITE_API_PROXY_TARGET=http://localhost:8000
